---
import Layout from "@/layouts/Layout.astro"
import { HeroSection } from "@/components/HeroSection"
import { WorkGrid } from "@/components/WorkCard"
import { SectionTitle } from "@/components/SectionTitle"
import { getWorks } from "@/lib/works"

let works: Awaited<ReturnType<typeof getWorks>> = []
try {
  works = await getWorks()
} catch {}
// Web works first, then video
const webWorks = works.filter((w) => w.type === "web")
const videoWorks = works.filter((w) => w.type === "video")
const featured = [...webWorks, ...videoWorks].slice(0, 6)
---

<Layout>
  <HeroSection client:load />

  <section class="container section">
    <div class="section-header">
      <SectionTitle client:visible title="Works" sub="Selected projects" />
      <a href="/works" class="view-all">View All →</a>
    </div>
    <WorkGrid client:visible works={featured} enableViewTransition={false} />
  </section>

  <section class="container">
    <a href="/contact" class="contact-link">
      <span class="contact-label">Contact</span>
      <span class="contact-text">お仕事のご相談・ご依頼はこちらから</span>
      <span class="contact-arrow" aria-hidden="true">→</span>
    </a>
  </section>
</Layout>

<style>
  .section {
    padding-top: 80px;
    padding-bottom: 80px;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
  }

  .view-all {
    font-size: 14px;
    color: var(--color-text-secondary);
    transition: color 0.2s;
    margin-bottom: 52px;
    white-space: nowrap;
  }

  .view-all:hover {
    color: var(--color-text);
  }

  .contact-link {
    display: flex;
    align-items: center;
    gap: 24px;
    padding: 40px 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text);
  }

  .contact-label {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--color-text-secondary);
    width: 96px;
    flex-shrink: 0;
  }

  .contact-text {
    flex: 1;
    font-size: clamp(16px, 2.4vw, 24px);
    font-weight: 700;
  }

  .contact-arrow {
    font-size: 20px;
    transition: transform 0.3s var(--ease-out-expo);
  }

  .contact-link:hover .contact-arrow {
    transform: translateX(6px);
  }

  @media (max-width: 768px) {
    .section {
      padding-top: 48px;
      padding-bottom: 48px;
    }

    .section-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
      margin-bottom: 8px;
    }

    .view-all {
      margin-bottom: 24px;
    }

    .contact-link {
      flex-wrap: wrap;
      gap: 8px 16px;
      padding: 32px 0;
    }

    .contact-label {
      width: 100%;
    }
  }
</style>

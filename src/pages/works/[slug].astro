---
import Layout from "@/layouts/Layout.astro"
import { getWorkDetail, getWorks } from "@/lib/works"

const { slug } = Astro.params

if (!slug) {
  return Astro.redirect("/works")
}

const work = await getWorkDetail(slug)
const allWorks = await getWorks()
const currentIndex = allWorks.findIndex((w) => w.slug === slug)
const prevWork = currentIndex > 0 ? allWorks[currentIndex - 1] : null
const nextWork = currentIndex < allWorks.length - 1 ? allWorks[currentIndex + 1] : null
---

<Layout
  title={work.title}
  description={work.description}
  ogImage={work.eyecatch}
>
  <article class="container">
    <header class="hero">
      {
        work.eyecatch && (
          <img
            src={work.eyecatch}
            alt={work.title}
            class="hero-image"
            style={`view-transition-name: work-image-${slug}`}
          />
        )
      }
    </header>

    <div class="content-wrap">
      <div class="meta">
        {work.category && <span class="category">{work.category}</span>}
        <span class="year">{work.year}</span>
        {
          work.soft && work.soft.length > 0 && (
            <div class="soft-list">
              {work.soft.map((s: string) => (
                <span class="soft-tag">{s}</span>
              ))}
            </div>
          )
        }
      </div>

      <h1 class="title">{work.title}</h1>

      {work.description && <p class="description">{work.description}</p>}

      <div class="rich-content">
        <work.Content />
      </div>
    </div>

    <nav class="work-nav">
      <div class="work-nav-item">
        {prevWork && (
          <a href={`/works/${prevWork.slug}`} class="work-nav-link prev">
            <span class="work-nav-label">← Prev</span>
            <span class="work-nav-title">{prevWork.title}</span>
          </a>
        )}
      </div>
      <div class="work-nav-center">
        <a href="/works" class="work-nav-back">All Works</a>
      </div>
      <div class="work-nav-item">
        {nextWork && (
          <a href={`/works/${nextWork.slug}`} class="work-nav-link next">
            <span class="work-nav-label">Next →</span>
            <span class="work-nav-title">{nextWork.title}</span>
          </a>
        )}
      </div>
    </nav>
  </article>
</Layout>

<style>
  .hero {
    margin-top: 40px;
    border-radius: 16px;
    overflow: hidden;
    background-color: var(--color-bg-subtle);
  }

  .hero-image {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .content-wrap {
    max-width: 720px;
    margin: 48px auto 0;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 16px;
  }

  .category {
    font-size: 13px;
    font-weight: 600;
    color: var(--color-accent);
    letter-spacing: 0.03em;
  }

  .year {
    font-size: 13px;
    color: var(--color-text-secondary);
  }

  .soft-list {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }

  .soft-tag {
    font-size: 11px;
    padding: 2px 8px;
    border-radius: 4px;
    background-color: var(--color-bg-subtle);
    color: var(--color-text-secondary);
    font-weight: 500;
  }

  .title {
    font-size: clamp(24px, 4vw, 36px);
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: 16px;
  }

  .description {
    font-size: 15px;
    color: var(--color-text-secondary);
    line-height: 1.8;
    margin-bottom: 40px;
  }

  .rich-content {
    line-height: 1.9;
    font-size: 15px;
  }

  .rich-content :global(img) {
    border-radius: 8px;
    margin: 24px 0;
  }

  .rich-content :global(h2) {
    font-size: 20px;
    font-weight: 700;
    margin-top: 48px;
    margin-bottom: 16px;
  }

  .rich-content :global(h3) {
    font-size: 17px;
    font-weight: 600;
    margin-top: 32px;
    margin-bottom: 12px;
  }

  .rich-content :global(p) {
    margin-bottom: 16px;
  }

  .rich-content :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .rich-content :global(iframe) {
    width: 100%;
    aspect-ratio: 16 / 9;
    border: none;
    border-radius: 8px;
    margin: 24px 0;
  }

  .work-nav {
    margin-top: 64px;
    padding-top: 32px;
    border-top: 1px solid var(--color-border);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 16px;
    align-items: start;
  }

  .work-nav-item {
    min-width: 0;
  }

  .work-nav-item:last-child {
    text-align: right;
  }

  .work-nav-link {
    display: inline-flex;
    flex-direction: column;
    gap: 4px;
    text-decoration: none;
    color: inherit;
    padding: 8px 0;
    transition: color 0.2s;
  }

  .work-nav-link:hover {
    color: var(--color-accent);
  }

  .work-nav-label {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: var(--color-text-secondary);
    transition: color 0.2s;
  }

  .work-nav-link:hover .work-nav-label {
    color: var(--color-accent);
  }

  .work-nav-title {
    font-size: 14px;
    font-weight: 500;
    line-height: 1.4;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 280px;
  }

  .work-nav-center {
    display: flex;
    align-items: center;
    padding-top: 8px;
  }

  .work-nav-back {
    font-size: 13px;
    color: var(--color-text-secondary);
    text-decoration: none;
    padding: 6px 16px;
    border-radius: 100px;
    border: 1px solid var(--color-border);
    transition: all 0.2s;
    white-space: nowrap;
  }

  .work-nav-back:hover {
    border-color: var(--color-text);
    color: var(--color-text);
  }

  @media (max-width: 640px) {
    .work-nav {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: auto auto;
    }

    .work-nav-center {
      grid-column: 1 / -1;
      justify-content: center;
      order: -1;
      padding-bottom: 16px;
      border-bottom: none;
    }

    .work-nav-title {
      max-width: 140px;
    }
  }
</style>

---
import Layout from "@/layouts/Layout.astro"
import { WorkGrid } from "@/components/WorkCard"
import { SectionTitle } from "@/components/SectionTitle"
import { BoothSection } from "@/components/BoothSection"
import { getWorks } from "@/lib/works"

let works: Awaited<ReturnType<typeof getWorks>> = []
try {
  works = await getWorks()
} catch {}

const webWorks = works.filter((w) => w.type === "web")
const videoWorks = works.filter((w) => w.type === "video")
const downloadCount = 1
---

<Layout title="Works" description="ROTO Works - Portfolio">
  <div class="container">
    <section class="section">
      <div class="section-header">
        <SectionTitle client:visible title="Works" sub="制作実績" />
        <nav class="section-nav">
        {webWorks.length > 0 && (
          <a href="#web" class="section-nav-item">
            <span class="section-nav-label">Web</span>
            <span class="section-nav-count">{webWorks.length}</span>
          </a>
        )}
        {videoWorks.length > 0 && (
          <a href="#video" class="section-nav-item">
            <span class="section-nav-label">Video / Motion</span>
            <span class="section-nav-count">{videoWorks.length}</span>
          </a>
        )}
        <a href="#downloads" class="section-nav-item">
          <span class="section-nav-label">Downloads</span>
          <span class="section-nav-count">{downloadCount}</span>
        </a>
        </nav>
      </div>

      {webWorks.length > 0 && (
        <div id="web" class="works-section">
          <h3 class="works-section-title">Web</h3>
          <WorkGrid client:visible works={webWorks} />
        </div>
      )}

      {videoWorks.length > 0 && (
        <div id="video" class="works-section">
          <h3 class="works-section-title">Video / Motion</h3>
          <WorkGrid client:visible works={videoWorks} enableViewTransition={webWorks.length === 0} />
        </div>
      )}
    </section>

    <section id="downloads" class="section booth-section">
      <BoothSection client:visible />
    </section>
  </div>
</Layout>

<style>
  .section {
    padding-top: 80px;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 48px;
  }

  .section-nav {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 52px;
  }

  .section-nav-item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-radius: 100px;
    border: 1px solid var(--color-border);
    text-decoration: none;
    color: var(--color-text);
    font-size: 13px;
    font-weight: 500;
    transition: all 0.2s;
    scroll-behavior: smooth;
  }

  .section-nav-item:hover {
    border-color: var(--color-text);
    background-color: var(--color-text);
    color: var(--color-white);
  }

  .section-nav-item:hover .section-nav-count {
    background-color: rgba(255, 255, 255, 0.2);
    color: var(--color-white);
  }

  .section-nav-count {
    font-size: 11px;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 100px;
    background-color: var(--color-bg-subtle);
    color: var(--color-text-secondary);
    transition: all 0.2s;
  }

  .works-section {
    margin-bottom: 64px;
    scroll-margin-top: 80px;
  }

  .works-section:last-child {
    margin-bottom: 0;
  }

  .works-section-title {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    margin-bottom: 24px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--color-border);
  }

  .booth-section {
    margin-top: 80px;
    padding-top: 64px;
    border-top: 1px solid var(--color-border);
    scroll-margin-top: 80px;
  }

  @media (max-width: 768px) {
    .section {
      padding-top: 48px;
    }

    .section-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
      margin-bottom: 32px;
    }

    .section-nav {
      margin-bottom: 0;
      width: 100%;
    }

    .works-section {
      margin-bottom: 48px;
    }

    .booth-section {
      margin-top: 48px;
      padding-top: 40px;
    }
  }
</style>

<script>
  document.documentElement.style.scrollBehavior = 'smooth'
</script>

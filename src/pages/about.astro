---
import Layout from "@/layouts/Layout.astro"
import { SectionTitle } from "@/components/SectionTitle"
import { getLogs } from "@/lib/microcms"

let logs: Awaited<ReturnType<typeof getLogs>> = []
try {
  logs = await getLogs()
} catch {}
---

<Layout title="About" description="ROTO - Video / Motion Graphics / Web">
  <div class="container">
    <section class="section">
      <SectionTitle client:visible title="About" />

      <div class="about-grid">
        <div class="about-main">
          <p class="about-text">
            映像・モーショングラフィックス・Web制作を行っています。
          </p>
          <p class="about-text">
            視覚的なストーリーテリングを通じて、アイデアを形にすることを大切にしています。
          </p>

          <div class="skills">
            <h3 class="skills-title">Skills</h3>
            <div class="skill-tags">
              <span class="skill-tag">After Effects</span>
              <span class="skill-tag">Blender</span>
              <span class="skill-tag">DaVinci Resolve</span>
              <span class="skill-tag">Illustrator</span>
              <span class="skill-tag">TypeScript</span>
              <span class="skill-tag">React</span>
              <span class="skill-tag">Nuxt / Vue</span>
              <span class="skill-tag">Astro</span>
            </div>
          </div>
        </div>

        <div class="about-side">
          <div class="showreel">
            <a
              href="https://www.youtube.com/watch?v=10331qcWriU"
              target="_blank"
              rel="noopener noreferrer"
              class="reel-link"
            >
              <div class="reel-thumb">
                <img src="https://img.youtube.com/vi/10331qcWriU/maxresdefault.jpg" alt="Showreel 2024" class="reel-img" />
                <div class="reel-play">
                  <svg width="40" height="40" viewBox="0 0 24 24" fill="white">
                    <path d="M8 5v14l11-7z"></path>
                  </svg>
                </div>
              </div>
              <span class="reel-label">Showreel 2024</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    {
      logs.length > 0 && (
        <section class="section timeline-section">
          <h2 class="timeline-title">Timeline</h2>
          <div class="timeline">
            {logs.map((log) => (
              <div class="timeline-item">
                <div class="timeline-date">
                  {new Date(log.date).toLocaleDateString("ja-JP", {
                    year: "numeric",
                    month: "short",
                  })}
                </div>
                <div class="timeline-content">
                  <h3 class="timeline-item-title">{log.title}</h3>
                  {log.content && (
                    <p class="timeline-desc">{log.content}</p>
                  )}
                </div>
              </div>
            ))}
          </div>
        </section>
      )
    }
  </div>
</Layout>

<style>
  .section {
    padding-top: 80px;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 360px;
    gap: 64px;
    align-items: start;
  }

  .about-text {
    font-size: 15px;
    line-height: 2;
    color: var(--color-text-secondary);
    margin-bottom: 8px;
  }

  .skills {
    margin-top: 40px;
  }

  .skills-title {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    margin-bottom: 16px;
  }

  .skill-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .skill-tag {
    font-size: 13px;
    padding: 6px 14px;
    border-radius: 100px;
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    transition: all 0.2s;
  }

  .skill-tag:hover {
    border-color: var(--color-text);
    color: var(--color-text);
  }

  .showreel {
    position: sticky;
    top: 96px;
  }

  .reel-link {
    display: block;
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    border: 1px solid var(--color-border);
    transition: transform 0.3s var(--ease-out-expo), box-shadow 0.3s;
  }

  .reel-link:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
  }

  .reel-thumb {
    aspect-ratio: 16 / 9;
    background: var(--color-dark);
    position: relative;
    overflow: hidden;
  }

  .reel-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s var(--ease-out-expo);
  }

  .reel-link:hover .reel-img {
    transform: scale(1.03);
  }

  .reel-play {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.3);
    transition: background 0.3s;
  }

  .reel-link:hover .reel-play {
    background: rgba(0, 0, 0, 0.15);
  }

  .reel-label {
    display: block;
    padding: 14px 16px;
    font-size: 14px;
    font-weight: 600;
  }

  .timeline-section {
    margin-top: 80px;
    padding-top: 64px;
    border-top: 1px solid var(--color-border);
  }

  .timeline-title {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    margin-bottom: 32px;
  }

  .timeline {
    display: flex;
    flex-direction: column;
  }

  .timeline-item {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 24px;
    padding: 20px 0;
    border-top: 1px solid var(--color-border);
  }

  .timeline-date {
    font-size: 13px;
    color: var(--color-text-secondary);
    padding-top: 2px;
  }

  .timeline-item-title {
    font-size: 15px;
    font-weight: 600;
    line-height: 1.5;
  }

  .timeline-desc {
    font-size: 14px;
    color: var(--color-text-secondary);
    margin-top: 4px;
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .showreel {
      position: static;
    }

    .timeline-item {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
